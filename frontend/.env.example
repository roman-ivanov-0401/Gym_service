# URL-ы бекендов для серверных запросов Next (BFF, RSC, middleware)
AUTH_SERVICE_URL=http://127.0.0.1:3000
GYM_SERVICE_URL=http://127.0.0.1:3001

# Почта для формы обратной связи (API route /api/feedback → nodemailer)
# Куда слать письмо (ящик администратора)
ADMIN_EMAIL=you@mail.ru

# Mail.ru: включите «Пароль для внешнего приложения» в настройках почты
# SMTP: https://help.mail.ru/mail-help/mailer/popsmtp
SMTP_HOST=smtp.mail.ru
SMTP_PORT=465
SMTP_USER=you@mail.ru
SMTP_PASS=
# Обычно совпадает с SMTP_USER; для Mail.ru — полный адрес ящика
SMTP_FROM=you@mail.ru

# Проверка TLS-сертификата SMTP (для Mail.ru / Gmail / Yandex оставьте 1)
SMTP_TLS_REJECT_UNAUTHORIZED=1

# Другие провайдеры (пример):
# Yandex: SMTP_HOST=smtp.yandex.ru SMTP_PORT=465
# Gmail:  SMTP_HOST=smtp.gmail.com SMTP_PORT=465 (нужен пароль приложения)
